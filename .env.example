NODE_ENV=production
HOST=0.0.0.0
PORT=3096
BD_DESK_DB=/data/bd-desk.db
# 32+ random bytes. Never commit the real value.
BD_DESK_LICENSE_SECRET=replace-with-a-long-random-secret
WEBHOOK_SIGNING_SECRET=replace-with-another-long-random-secret
# Optional. Google Books works without a key for low-volume public requests, but a key is recommended for quotas.
GOOGLE_BOOKS_API_KEY=
# Optional initial owner migration. Do not commit the CSV.
BD_DESK_SEED_CSV=
# Comma-separated browser origins allowed to call the MCP endpoint when an Origin header is present.
BD_DESK_ALLOWED_ORIGINS=https://bd-desk.example.com
